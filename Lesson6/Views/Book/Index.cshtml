@model IEnumerable<Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách sách</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm sách</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th class="text-end">Giá</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td class="text-end">@book.Price.ToString("N2")</td>
                <td>
                    <a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Chưa có sách nào.</td>
            </tr>
        }
    </tbody>
</table>
