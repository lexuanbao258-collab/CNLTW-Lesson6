@model Book

@{
    ViewData["Title"] = "Xóa sách";
}

<h1>Xóa sách</h1>
<p>Bạn có chắc muốn xóa sách này không?</p>

<dl class="row">
    <dt class="col-sm-2">Tên sách</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Tác giả</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Giá</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
